<?xml version="1.0" encoding="utf-8"?>
<!--
  次要按钮：白底 + 1dp 描边 + 主色文字（对齐 AiCode 的 OutlinedButton 观感）。
  按下时用主色容器色做底，仍保持主色描边，所以「能点」这件事不会因为按下而消失。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_surface" />
            <stroke android:width="1dp" android:color="@color/subtle_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <stroke android:width="1dp" android:color="@color/primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_surface" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
