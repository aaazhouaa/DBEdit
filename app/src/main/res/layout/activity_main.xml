<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：顶部顶栏 + 下方内容。
  视觉对齐 AiCode：浅灰页面底（#F8F8F8）、白色圆角卡片分组、扁平顶栏。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/toolbar"
            style="@style/Widget.DbEdit.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.DbEdit.Toolbar"
            app:title="@string/app_name" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp">

                <!-- 说明文字 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_intro"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />

                <!-- 打开数据源 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="24dp"
                    android:paddingBottom="8dp"
                    android:text="@string/main_group_open"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <include layout="@layout/item_action_row" android:id="@+id/rowPick" />

                    <View style="@style/Widget.DbEdit.Divider"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp" />

                    <include layout="@layout/item_action_row" android:id="@+id/rowDemo" />

                    <View style="@style/Widget.DbEdit.Divider"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp" />

                    <include layout="@layout/item_action_row" android:id="@+id/rowCreate" />
                </LinearLayout>

                <!-- 最近打开（无记录时整组隐藏） -->
                <LinearLayout
                    android:id="@+id/groupRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="24dp"
                        android:paddingBottom="8dp"
                        android:text="@string/main_group_recent"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">

                        <include layout="@layout/item_action_row" android:id="@+id/rowRecent" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 提示 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/main_tip"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
</LinearLayout>
