<?xml version="1.0" encoding="utf-8"?>
<!--
  侧边导航内容。宽度、底色对齐 AiCode 的 ChatDrawerContent：300dp、页面底色、左右 16dp。

  圆角与状态栏留白都放在这一层（而不是 DrawerLayout 的子视图上）：
  DrawerLayout 会给子视图套一层 FrameLayout 并自己消费掉 inset，
  如果把 padding/背景放在子视图，状态栏区域会没有底色、也拿不到 inset。
  目前只有「Edit」一项，后续在 navContainer 里追加 @layout/item_nav 即可。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_drawer"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- 顶部留白由代码按状态栏高度写入（id=navTopSpacer），
         避免第一张卡片被状态栏压住 -->
    <Space
        android:id="@+id/navTopSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <!-- 顶部只留状态栏留白，不加标题/分组小字：抽屉里只有一个工具，
         再写「Edit」「工具」属于重复信息，直接让列表当第一屏内容。 -->

    <!-- 白色圆角卡片包住所有工具项，后续直接在容器内追加条目 -->
    <LinearLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical" />
</LinearLayout>
